__pycache__/
*.pyc
vendor/

# The Qwen artifacts are NOT carried in the repo. They are pinned by
# SHA-256 in data/qwen/MANIFEST.json and fetched by tools/get_qwen.py.
# GitHub's hard limit is 100 MB PER FILE, which none of them exceeds --
# they are out of the tree because 117 MiB of data does not belong in a
# source repository, not because it would be refused.
data/qwen/*
!data/qwen/MANIFEST.json
